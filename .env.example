# Elaborado com apoio de IA (Claude Code) e revisado pelo autor.
# Copie este arquivo para .env e ajuste os valores. O .env é lido pela API, pelo seed e pelo Alembic
# e não vai para o git. Variáveis definidas no ambiente têm prioridade sobre o .env.

# Banco de dados. Por padrão, um SQLite local na pasta onde o comando é executado (a raiz do projeto).
DATABASE_URL=sqlite:///./raizes.db

# Segredo usado para assinar os tokens JWT. Use um valor aleatório e longo; para gerar um:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem esta variável, a API usa um segredo fixo de desenvolvimento, que não deve ser usado fora da máquina local.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
